{
  "id": "discord",
  "version": "2.0.0",
  "api": 2,
  "migrate": ["discord.json"],
  "permissions": {
    "http": ["discord.com"],
    "pipes": ["discord-ipc"],
    "oauth": {
      "discord": {
        "token": "https://discord.com/api/oauth2/token",
        "redirect": "http://127.0.0.1",
        "scopes": ["rpc", "rpc.voice.read", "rpc.voice.write"],
        "send": ["pipe:discord-ipc"]
      }
    }
  }
}
