{
  "id": "spotify",
  "version": "2.0.0",
  "api": 2,
  "migrate": ["spotify.json", "lyrics", "lyrics-offsets.json"],
  "permissions": {
    "http": ["api.spotify.com", "lrclib.net"],
    "oauth": {
      "spotify": {
        "authorize": "https://accounts.spotify.com/authorize",
        "token": "https://accounts.spotify.com/api/token",
        "redirect": "http://127.0.0.1:43821/callback",
        "scopes": [
          "user-library-read",
          "user-library-modify",
          "user-read-playback-state",
          "user-modify-playback-state"
        ],
        "send": ["api.spotify.com"]
      }
    }
  }
}
