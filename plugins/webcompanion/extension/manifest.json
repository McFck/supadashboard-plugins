{
  "manifest_version": 3,
  "name": "SupaDashboard WebCompanion",
  "version": "0.3.0",
  "minimum_chrome_version": "116",
  "incognito": "not_allowed",
  "key": "",
  "permissions": ["alarms", "scripting", "storage", "tabs"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["outline.js", "page.js"],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src ws://127.0.0.1:43822"
  },
  "background": { "service_worker": "worker.js", "type": "module" },
  "action": { "default_title": "SupaDashboard WebCompanion", "default_popup": "popup.html" }
}
